# ===== Alerta Plaga · Los Artilleros =====
# Copia este archivo como .env y llena los valores.
# NUNCA subas el .env real al repositorio.

# --- Bot de Telegram (BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Token del equipo en la API Alerta Plaga (header X-Equipo-Token) ---
EQUIPO_TOKEN=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cadena de respaldo si el modelo principal está saturado
GEMINI_MODELOS_ALTERNOS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# --- Chat de Telegram del coordinador (recibe los avisos) ---
COORDINADOR_CHAT_ID=

# --- Almacenamiento compartido (Supabase) ---
# Si se dejan vacías, el sistema usa archivos locales en data/.
SUPABASE_URL=
SUPABASE_KEY=

# --- Panel web ---
PORT=3000

# --- Comportamiento automático (1 = activado, 0 = desactivado) ---
PROCESAR_REPORTES=1
RESPONDER_TELEGRAM=1
AVISAR_URGENTES=1
REGISTRAR_CASOS=1

# auto = pregunta al productor solo si de verdad hace falta · off = nunca
PREGUNTAR=auto

# Reto extra: el coordinador aprueba en Telegram (botones Aprobar / Cambiar
# técnico) antes de que se le mande el folio al productor y el caso al técnico.
# 1 = pide aprobación · 0 = avisa de inmediato
APROBAR_ANTES_DE_AVISAR=1

# Cada cuánto se consultan reportes nuevos (ms)
INTERVALO_REPORTES_MS=60000

# Pausa entre llamadas a la IA (ms). Súbela si Gemini marca error 429.
RITMO_MS=4500

# --- Análisis visual de fotografías de Telegram ---
# Solo se analizan imágenes (jpg/png/webp). El resultado es SIEMPRE preliminar.
# 1 = analiza fotos · 0 = solo clasifica el pie de foto (comportamiento anterior)
VISION_ENABLED=1
# Tamaño máximo de la imagen descargada (bytes). 5242880 = 5 MB
VISION_MAX_BYTES=5242880
# Tiempo máximo para descargar la imagen y para la respuesta del modelo (ms)
VISION_TIMEOUT_MS=15000
# Máximo de fotografías analizadas por chat cada 10 minutos
VISION_MAX_POR_CHAT=5
# Espera máxima (ms) que se respeta ante un 429 temporal de Gemini
VISION_RETRY_AFTER_MAX_MS=3000
# Modelo multimodal (si se deja vacío se usa GEMINI_MODEL)
VISION_MODEL=gemini-3.5-flash
# Respaldos multimodales separados por comas (deben aceptar imágenes).
# NUNCA pongas aquí un modelo solo de texto: la imagen no se enviaría.
VISION_MODELOS_ALTERNOS=
