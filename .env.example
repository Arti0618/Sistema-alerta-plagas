# ===== Alerta Plaga · Los Artilleros =====
# Copia este archivo como .env y llena los valores.
# NUNCA subas el .env real al repositorio.

# --- Bot de Telegram (BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Token del equipo en la API Alerta Plaga (header X-Equipo-Token) ---
EQUIPO_TOKEN=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Cadena de respaldo si el modelo principal está saturado
GEMINI_MODELOS_ALTERNOS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite

# --- Chat de Telegram del coordinador (recibe los avisos) ---
COORDINADOR_CHAT_ID=

# --- Almacenamiento compartido (Supabase) ---
# Si se dejan vacías, el sistema usa archivos locales en data/.
SUPABASE_URL=
SUPABASE_KEY=

# --- Panel web ---
PORT=3000

# --- Comportamiento automático (1 = activado, 0 = desactivado) ---
PROCESAR_REPORTES=1
RESPONDER_TELEGRAM=1
AVISAR_URGENTES=1
REGISTRAR_CASOS=1

# auto = pregunta al productor solo si de verdad hace falta · off = nunca
PREGUNTAR=auto

# Reto extra: el coordinador aprueba en Telegram (botones Aprobar / Cambiar
# técnico) antes de que se le mande el folio al productor y el caso al técnico.
# 1 = pide aprobación · 0 = avisa de inmediato
APROBAR_ANTES_DE_AVISAR=1

# Cada cuánto se consultan reportes nuevos (ms)
INTERVALO_REPORTES_MS=60000

# Pausa entre llamadas a la IA (ms). Súbela si Gemini marca error 429.
RITMO_MS=4500
